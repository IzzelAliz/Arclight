+    private static Manifest readManifest() {
+        // API and implementation archives may share a class loader; do not cache its first manifest.
+        final String classLocation = "/" + ServerBuildInfoImpl.class.getName().replace('.', '/') + ".class";
+        final URL resource = ServerBuildInfoImpl.class.getResource(classLocation);
+        if (resource == null) {
+            return null;
+        }
+        final String classFilePath = resource.toExternalForm().replace("\\", "/");
+        final String archivePath = classFilePath.substring(0, classFilePath.length() - classLocation.length());
+        try (final InputStream stream = new URL(archivePath + "/META-INF/MANIFEST.MF").openStream()) {
+            return new Manifest(stream);
+        } catch (final IOException ex) {
+            return null;
+        }
+    }

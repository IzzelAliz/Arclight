+            for (Plugin registered : pluginManager.getPlugins()) {
+                if (registered == provided || registered.getClass().getClassLoader() == definingClassLoader) {
+                    // loadPlugin publishes to the plugin list before updating names and dependencies.
+                    // Even a partial registration leaves lifecycle ownership with the manager.
+                    return;
+                }
+            }
+
+            // Only this provider's loader, with no manager-owned plugin, can be reclaimed here.
+            try {
+                classLoader.close();
+            } catch (Throwable closeFailure) {
+                if (failure != closeFailure) {
+                    failure.addSuppressed(closeFailure);
+                }
+            } finally {
+                PaperClassLoaderStorage.instance().unregisterClassloader(classLoader);
+            }
+        } catch (Throwable cleanupFailure) {
+            if (failure != cleanupFailure) {
+                failure.addSuppressed(cleanupFailure);
+            }
+        }
+    }

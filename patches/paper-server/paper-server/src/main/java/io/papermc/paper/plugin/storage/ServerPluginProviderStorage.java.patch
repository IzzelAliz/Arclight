+    private static void closeUnregisteredPluginClassLoader(PaperPluginManagerImpl pluginManager, PluginProvider<JavaPlugin> provider, JavaPlugin provided, Throwable failure) {
+        try {
+            ClassLoader definingClassLoader = provided.getClass().getClassLoader();
+            if (!(definingClassLoader instanceof ConfiguredPluginClassLoader classLoader)
+                || classLoader.getPlugin() != provided
+                || classLoader.getConfiguration() != provider.getMeta()) {
+                // A custom bootstrap may return a plugin from another provider's loader.
+                return;

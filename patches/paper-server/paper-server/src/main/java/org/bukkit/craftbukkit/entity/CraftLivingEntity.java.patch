+    private net.minecraft.world.phys.EntityHitResult traceTargetEntity(int maxDistance) {
+        if (maxDistance < 1 || maxDistance > 120) {
+            throw new IllegalArgumentException("maxDistance must be between 1-120");
+        }
+        var handle = this.getHandle();
+        var start = handle.getEyePosition(1.0F);
+        var direction = handle.getLookAngle();
+        var end = start.add(direction.x * maxDistance, direction.y * maxDistance, direction.z * maxDistance);
+        var candidates = handle.level().getEntities(handle,
+            handle.getBoundingBox().expandTowards(direction.x * maxDistance, direction.y * maxDistance, direction.z * maxDistance).inflate(1.0),
+            net.minecraft.world.entity.EntitySelector.NO_SPECTATORS.and(net.minecraft.world.entity.Entity::isPickable));
+        double distance = 0.0;
+        net.minecraft.world.phys.EntityHitResult result = null;
+        for (net.minecraft.world.entity.Entity candidate : candidates) {
+            double radius = candidate.getPickRadius();
+            var box = candidate.getBoundingBox().inflate(radius, radius, radius);
+            var intersection = box.clip(start, end);
+            if (intersection.isPresent()) {
+                var hit = intersection.get();
+                double distanceTo = start.distanceToSqr(hit);
+                if (distanceTo < distance || distance == 0.0) {
+                    result = new net.minecraft.world.phys.EntityHitResult(candidate, hit);
+                    distance = distanceTo;
+                }
+            }
+        }
+        return result;
+    }

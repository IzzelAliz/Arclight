+package org.bukkit.craftbukkit.block;
+
+import com.google.common.base.Preconditions;
+import net.minecraft.world.level.block.entity.BlockEntity;
+import org.bukkit.Location;
+import org.bukkit.World;
+
+public final class CraftModdedBlockEntityState extends CraftBlockEntityState<BlockEntity> {
+
+    public CraftModdedBlockEntityState(World world, BlockEntity blockEntity) {
+        super(world, blockEntity);
+        Preconditions.checkState(this.getSnapshot() != null, "Failed to create snapshot for modded block entity %s", blockEntity.getType());
+    }
+
+    private CraftModdedBlockEntityState(CraftModdedBlockEntityState state, Location location) {
+        super(state, location);
+    }
+
+    @Override
+    public CraftModdedBlockEntityState copy() {
+        return new CraftModdedBlockEntityState(this, null);
+    }
+
+    @Override
+    public CraftModdedBlockEntityState copy(Location location) {
+        return new CraftModdedBlockEntityState(this, location);
+    }
+}
